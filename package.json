{
  "name": "blindspot-qloo",
  "version": "1.0.0",
  "description": "BLINDSPOT: Catch the quiet taste clashes driving your crowd away—and fix your launch plan with Qloo's Taste AI.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/blindspot.test.js",
    "qloo:status": "npx @qloo/qloo-harness setup --status --json",
    "qloo:doctor": "npx @qloo/qloo-harness doctor",
    "qloo:mcp": "npx @qloo/qloo-harness mcp",
    "qloo:exec:tags": "npx @qloo/qloo-harness exec find_tags --input-file workflows/find_tags.json",
    "qloo:exec:compare": "npx @qloo/qloo-harness exec compare_audiences --input-file workflows/compare_audiences.json",
    "qloo:exec:rank": "npx @qloo/qloo-harness exec rank --input-file workflows/rank_shortlist.json"
  },
  "keywords": [
    "qloo",
    "taste-ai",
    "agentic-hackathon",
    "cultural-intelligence",
    "autonomous-agents"
  ],
  "author": "GreatSage-dev",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  }
}
